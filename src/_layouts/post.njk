---
layout: base.njk
---
<div>
  <div>
    <h1 class="text-2xl mb-4">{{ title }}</h1>
  </div>
  <div class="text-sm mb-4">
    <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
  </div>
  <div>
    <a href="{{ heroimage }}">
      <img src="{{ heroimage }}" alt="{{ heroalt }}" width="1280" eleventy:widths="1280" class="rounded-md w-full" />
    </a>
  </div>

  <div class="my-4">
{{ content | safe }}
  </div>

{% if images %}
  <div class="my-4">
    <h3 class="pb-4 text-lg">Images</h3>
      <div class="grid grid-cols-4 gap-4">
      {% for image in images %}
        <a href="{{ image.src }}">
          <img 
            src="{{ image.src }}"
            alt="{{ image.alt }}"
            class="rounded-sm mr-4" 
            eleventy:widths=400
            width=400 />
        </a>
      {% endfor %}
      </div>
  </div>
{% endif %}


  {% if tags %}
  {% for tag in tags | filterTagList %}
  {% if tag != "posts" %}
  <a href="/tags/{{ tag | slugify }}" class="inline-block bg-base-300 rounded-full px-3 py-1 text-sm font-semibold text-base-content mr-2">{{ tag }}</a>
  {% endif %}
  {% endfor %}
  {% endif %}

{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<div class="grid grid-cols-2 gap-4">
	{%- if previousPost %}
  <div class="">
    <div class="text-right">← Previous</div> 
    <div class="text-right text-lg">
      <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>
    </div>
  </div>
  {% endif %} 
	{%- if nextPost %}
  <div class="">
    <div>Next →</div>
    <div class="text-lg">
      <a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></div>{% endif %}
    </div>
</div>
{%- endif %}
{%- endif %}